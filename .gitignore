# Python bytecode and caches: regenerated by the interpreter on every run, so they are never committed.
# The `*.so`/`.Python` entries cover compiled extensions and framework builds.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# Packaging and build output (setuptools/wheel). `lib/`, `parts/`, `var/` and friends are leftovers of old
# buildout/distutils layouts; ignored so a local `pip install .` leaves the tree clean.
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments hold machine-specific interpreters; `.env` files commonly hold local secrets. Never commit them.
# Virtual environments
.env
.venv
env/
venv/
ENV/

# Temporary and test artifacts
# Scratch files written while scanning and testing; `.pytest_cache/` and `.cache/` are tool caches.
*.tmp
.cache/
.pytest_cache/
